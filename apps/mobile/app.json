{
  "expo": {
    "name": "Pylos",
    "slug": "pylos",
    "scheme": "tripplanner",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f0e8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.tripplanner"
    },
    "android": {
      "package": "com.example.tripplanner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3f7472"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "Pylos reads past events once to find your trips, hotel stays and restaurant reservations. Only the places it finds are saved.",
          "remindersPermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Pylos looks at where and when your photos were taken to find the trips you've been on. Your photos never leave your phone.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
