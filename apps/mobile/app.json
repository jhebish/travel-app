{
  "expo": {
    "name": "Pylos",
    "slug": "pylos",
    "owner": "pylos",
    "scheme": ["pylos", "tripplanner"],
    "version": "1.0.0",
    "runtimeVersion": { "policy": "sdkVersion" },
    "updates": { "url": "https://u.expo.dev/b039f479-663c-444b-adda-766546125b49" },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.pylos.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.pylos.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3f7472"
      },
      "blockedPermissions": ["android.permission.WRITE_CALENDAR", "android.permission.WRITE_EXTERNAL_STORAGE"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#f6f0e8",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#1d171c"
          }
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Pylos reads past events once to find your trips, hotel stays and restaurant reservations. Only the places it finds are saved.",
          "remindersPermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Pylos looks at where and when your photos were taken to find the trips you've been on. Your photos never leave your phone.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": ["photo"]
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#3f7472"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": { "projectId": "b039f479-663c-444b-adda-766546125b49" }
    }
  }
}
