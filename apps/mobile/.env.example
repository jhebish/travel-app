# Copy to .env. Expo exposes EXPO_PUBLIC_* values to the app bundle, so only public values go here.
# Your deployed web app (it hosts the API), e.g. https://your-app.vercel.app
# For local dev on a device, use your computer's LAN address, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
