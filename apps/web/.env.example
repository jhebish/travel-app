# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com) ---
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5-5
CLAUDE_MODEL=
# Faster model for per-day, hotel and swap calls (default claude-haiku-5-5). Set it equal to CLAUDE_MODEL to turn off.
CLAUDE_FAST_MODEL=

# --- Google Places API (New) — enable "Places API (New)" in Google Cloud ---
GOOGLE_PLACES_API_KEY=

# --- Expedia Rapid (optional; live hotel rates) ---
# Leave blank to show estimated nightly ranges only.
EXPEDIA_RAPID_API_KEY=
EXPEDIA_RAPID_SHARED_SECRET=
# Test environment: https://test.ean.com  Production: https://api.ean.com
EXPEDIA_RAPID_BASE_URL=https://test.ean.com

# --- Limits ---
# Trips one traveler can generate per hour
TRIPS_PER_HOUR=10

# --- Map tiles (optional) ---
# Defaults to OpenStreetMap's free tiles (fine for modest traffic). For production volume,
# use a keyed provider, e.g. MapTiler: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
