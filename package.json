{
  "name": "travel-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @travel/web dev",
    "dev:mobile": "pnpm --filter @travel/mobile start",
    "build": "pnpm --filter @travel/web build",
    "test": "pnpm --filter @travel/core --filter @travel/web test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @travel/web lint"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "typescript": "5.6.3"
  }
}
